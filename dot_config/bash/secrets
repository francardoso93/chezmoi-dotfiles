# Secret env vars, resolved from `pass` when an interactive shell starts.
# Only `pass show` commands belong here, never literal values: this repo is public.
# Tools (and Claude Code, which inherits this env) can then use "$PINATA_JWT"
# without the value ever being printed.

_pass_export() {  # _pass_export VAR pass-entry
  local v
  v="$(pass show "$2" 2>/dev/null)" && [[ -n "$v" ]] && export "$1=$v"
}

_pass_export PINATA_JWT pinata-dev-jwt

unset -f _pass_export
