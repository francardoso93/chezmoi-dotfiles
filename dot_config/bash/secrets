# Secret env vars, resolved from `pass` when an interactive shell starts.
# Only `pass show` commands belong here, never literal values: this repo is public.
# Tools (and Claude Code, which inherits this env) can then use "$PINATA_JWT"
# without the value ever being printed.

_pass_export() {  # _pass_export VAR pass-entry
  local v
  v="$(pass show "$2" 2>/dev/null)" && [[ -n "$v" ]] && export "$1=$v"
}

# _pass_export PINATA_JWT pinata-dev-jwt
_pass_export PINATA_JWT pinata-jwt

# Both environments at once, for scripts that compare dev against prod.
_pass_export PINATA_DEV_JWT pinata-dev-jwt
_pass_export PINATA_PROD_JWT pinata-jwt

# Cloudflare prod account user token (Workers R2 Storage + Queues Edit), for the
# pinata-learn-agent e2e scripts. Not CLOUDFLARE_API_TOKEN: wrangler would pick it up.
_pass_export CF_PROD_R2_TOKEN cloudflare-token-prod-r2-local-test

unset -f _pass_export
